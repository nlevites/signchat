# livekit cloud — minted into jwts in /api/livekit/token (step-02.4)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# openrouter — used by /api/openrouter/session-key to mint credit-capped child keys (step-02.5)
OPENROUTER_MANAGEMENT_API_KEY=

# elevenlabs — used by /api/elevenlabs/signed-url (TTS) and
# /api/elevenlabs/stt-signed-url (Realtime STT scribe_v2_realtime) to mint
# short-lived single-use tokens for the deaf client.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
