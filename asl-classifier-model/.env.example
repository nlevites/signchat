# Copy this file to `.env` and fill in your own credentials.
# `.env` is gitignored so your credentials never enter the repo.
#
# How `make` targets pick up these values:
#   .env is sourced via `set -a && source .env && set +a` at the top of any
#   pod-spawning script, so the variables become real env vars for the
#   subprocess (RunPod SDK, kagglehub, etc.).

# ---------------------------------------------------------------- RunPod
# Required for any `make pod-*` target (pod-train, pod-extract, etc.).
# Get one at https://www.runpod.io/console/user/settings -> "API Keys".
# Budget ballpark: ~$8 for a full PopSign 250 train; ~$28 for the
# broad+tight cross-dataset path.
RUNPOD_API_KEY=

# ---------------------------------------------------------------- Kaggle
# Required for any data-fetching target: `make wlasl`, `make wlasl-full`,
# `make asl-citizen`, `make asl-citizen-targeted`, plus the pod-side
# kagglehub downloads invoked by `make pod-extract`.
#
# Get them at https://www.kaggle.com/settings -> "Create New API Token";
# that gives you a kaggle.json file. Either:
#   (a) place kaggle.json at ~/.kaggle/kaggle.json (chmod 600), OR
#   (b) set the two vars below from the values inside that JSON.
# (Both paths work; the loaders check both and prefer the env vars when set.)
KAGGLE_USERNAME=
KAGGLE_KEY=


RUNPOD_S3_KEY=
RUNPOD_S3_ACCESS_KEY=