OPENROUTER_API_KEY=""
OPENROUTER_APP_URL="http://localhost:3010"
OPENROUTER_APP_NAME="SignChat Prompt Tester"
# Note: GROK_API_KEY is only needed if running the main bh2k26 web prototype, not this service.
# Remote OpenRouter embeddings are enabled by default for semantic similarity scoring.
# Set OPENROUTER_EMBEDDINGS=0 to disable; override the model with OPENROUTER_EMBEDDING_MODEL.
# OPENROUTER_EMBEDDINGS=0
# OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-large"
# LLM naturalness judge runs by default (GPT-5.4-mini, deterministic at temp=0 + seed).
# Opt out per request with ?judge=0; override the model below.
# OPENROUTER_JUDGE_MODEL="openai/gpt-5.4-mini"
