# SignChat Workbench environment
# Copy to .env (gitignored) and fill in values.
# All variables are server-only — read by app/api/* routes; the browser never
# sees a root provider key. See ARCHITECTURE.md §10 for route contracts.

# === LiveKit Cloud ============================================================
# Used by app/api/livekit/token to mint short-lived participant JWTs (§10.1).
# Get from: LiveKit Cloud dashboard → Project → API Keys.
# JWTs are signed locally with API_KEY + SECRET; no per-call hit on LiveKit.
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# === OpenRouter ===============================================================
# PROVISIONING KEY, not a regular inference API key. Has the "keys" scope so it
# can mint capped child keys via POST /api/v1/keys for app/api/openrouter/session-key
# (§10.2). Get from: https://openrouter.ai/settings/provisioning-keys.
# Distinct from the OPENROUTER_API_KEY used by prompt-tester-service.
OPENROUTER_MANAGEMENT_API_KEY=""

# Optional. Identifies this app to OpenRouter for dashboard analytics + the
# public rankings at openrouter.ai/rankings. Sent as HTTP-Referer and X-Title
# headers on every chat/completions call. Safe to omit; traffic shows up as
# "Anonymous" in your dashboard.
OPENROUTER_APP_URL="http://localhost:3020"
OPENROUTER_APP_NAME="SignChat Workbench"

# === ElevenLabs ===============================================================
# Used by app/api/elevenlabs/signed-url to mint short-lived streaming-WSS URLs
# for browser-direct TTS (§10.3). Get from: ElevenLabs → Profile → API Keys.
ELEVENLABS_API_KEY=""

# Default voice id used when /api/elevenlabs/signed-url request omits one.
# Pick any voice id from the ElevenLabs Voice Library; the value below is
# "Rachel", a common premade default.
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"
